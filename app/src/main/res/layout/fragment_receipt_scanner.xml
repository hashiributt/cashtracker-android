<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:background="@drawable/img_3">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:backgroundTint="@android:color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receipt Scanner"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <ImageView
                android:id="@+id/image_receipt_preview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="12dp"
                android:background="#F1F1F1"
                android:contentDescription="Receipt Preview" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capture_receipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Take Photo"
                android:icon="@android:drawable/ic_menu_camera"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/text_extracted_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extracted details will appear here..."
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:background="#EAEAEA"
                android:padding="16dp"
                android:minHeight="120dp"
                android:gravity="start|top"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
